# Bu faylni nusxalab ".env" nomi bilan saqlang, so'ng haqiqiy qiymatlarni kiriting.
# ".env" fayli GitHub'ga yuklanmaydi (.gitignore'da) — maxfiy ma'lumotlaringiz xavfsiz qoladi.

# Tasodifiy, uzun va hech kimga aytilmaydigan matn (sessiyalarni himoya qiladi)
JWT_SECRET=bu-yerga-uzun-tasodifiy-matn-yozing

# Turso — bepul, doimiy bulutli ma'lumotlar bazasi (turso.tech). Sozlanmasa,
# lokal data.sqlite fayli ishlatiladi (bepul hostingda vaqti-vaqti bilan tozalanishi mumkin).
TURSO_DATABASE_URL=libsql://sizning-baza-nomi.turso.io
TURSO_AUTH_TOKEN=sizning-turso-tokeningiz

# Cloudinary — bepul, doimiy bulutli fayl saqlash (cloudinary.com), rezyumelar uchun.
# Sozlanmasa, fayllar serverning lokal uploads/ papkasida saqlanadi.
CLOUDINARY_CLOUD_NAME=sizning-cloud-nomi
CLOUDINARY_API_KEY=sizning-api-key
CLOUDINARY_API_SECRET=sizning-api-secret

# Email yuborish uchun — Brevo TAVSIYA ETILADI (Render/Railway kabi hostinglarda
# Gmail SMTP ba'zan IPv6 muammosi tufayli ishlamaydi, Brevo esa HTTP orqali ishlagani
# uchun bu muammoga duch kelmaydi). brevo.com'da bepul ro'yxatdan o'tib oling.
BREVO_API_KEY=sizning-brevo-api-kalitingiz
BREVO_SENDER_EMAIL=sizning-tasdiqlangan-email@gmail.com

# SMTP (Gmail va h.k.) — Brevo sozlanmasa shu ishlatiladi (faqat lokal test uchun tavsiya etiladi)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sizning-email@gmail.com
SMTP_PASS=16-xonali-app-parol
SMTP_FROM=sizning-email@gmail.com

# Admin panelga (/admin.html) kira oladigan email(lar), vergul bilan ajratilgan
ADMIN_EMAILS=sizning-email@gmail.com
